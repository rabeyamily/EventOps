# Docker Compose Environment Variables

# Session secret used to sign session cookies
SESSION_SECRET=your-super-secret-session-key-change-this

# Google Form -> EventOps Students webhook secret
GOOGLE_FORM_WEBHOOK_SECRET=replace-with-long-random-secret

# Published Google Sheet CSV URL for semester imports from Students page (Admin action)
GOOGLE_FORM_SHEET_CSV_URL=

# Optional: semester-to-sheet mapping as JSON object (used first when importing by semester)
# Example:
# GOOGLE_FORM_SHEET_CSV_URLS_JSON={"Spring 2027":"https://docs.google.com/...&output=csv","Fall 2026":"https://docs.google.com/...&output=csv"}
GOOGLE_FORM_SHEET_CSV_URLS_JSON=
